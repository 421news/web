{{!< default}}

{{!-- Meta en inglés SERVER-SIDE. Antes esto se hacía por JS (document.title + setMeta), así que el
     HTML crudo de /en/ salía con el título y la descripción en español y og:locale=es_AR: cualquier
     crawler o scraper que no ejecuta JS veía la home inglesa como si fuera la española.
     Los strings son exactamente los que ya usaba el JS — no se cambió el copy, solo dónde se emite. --}}
{{#contentFor "metaTitle"}}421 | Quality content for your cognitive diet{{/contentFor}}
{{#contentFor "ogTitle"}}421 | Quality content for your cognitive diet{{/contentFor}}
{{#contentFor "metaDescription"}}Argentine digital media about culture, technology, games, and real life. Essays, features, guides, and interviews.{{/contentFor}}
{{#contentFor "ogDescription"}}Argentine digital media about culture, technology, games, and real life. Essays, features, guides, and interviews.{{/contentFor}}
{{#contentFor "ogLocale"}}en_US{{/contentFor}}

<div class="page-wrapper">
  {{> "general-styling"}}
  {{> "site-nav-en"}}
  <main>
    <h1 class="sr-only">421 — Quality content for your cognitive diet</h1>

    <!-- FEATURED POST -->
    {{> "index-featured-post" languageFilter="'hash-en'"}}

    <!-- WIZARD SUBSCRIBE BANNER -->
    {{> "home-subscribe-banner" en=true}}

    <!-- HIGHLIGHTED POSTS -->
    {{> "index-highlighted-posts-en"}}

    <!-- MOST READ (dynamic, GA4 historical) -->
    {{> "index-most-read-en"}}

    <!-- FILE BROWSER NAVIGATION -->
    <div class="global-container pt-small pb-small">
      {{> "file-browser-en"}}
    </div>

    <!-- LAST POSTS -->
    {{> "last-posts-en"}}
  </main>

  {{> "site-footer" lang="en"}}

</div>
<script src="{{asset "js/pagination.js"}}" defer></script>
<script src="{{asset "js/home-ruta.js"}}" defer></script>
