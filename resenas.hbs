{{!< default}}

{{!-- Reseñas de libros — landing de la sección.
     Ruta: /es/resenas/ (routes.yaml, data: page.resenas)
     La membresía es el tag público `resena`; en inglés es `review` (reviews.hbs).

     Misma estructura que las secciones (tag-cultura, tag-tecnologia): cabecera
     con nombre, cantidad y descripción del tag —los tres salen de Ghost— más el
     listado con "Cargar más". Sin CSS propio: todo sale de componentes que ya
     tienen su regla de modo claro. --}}

{{> "breadcrumb-tag" tagName="Reseñas"}}

  <div class="page-wrapper">
    {{> "general-styling"}}
    {{> "site-nav-es"}}
    <main>
      <!-- CABECERA DE SECCIÓN -->
      {{> "tag-hero-section" tagSlug="resena" languageFilter="-'hash-en'" eyebrow="Sección" postsLabel="reseñas" titulo="Reseñas de libros" sinDestacados=true}}

      <!-- LISTADO -->
      {{> "last-posts-es-tag" tag="resena"}}

    </main>

    <!-- FILE BROWSER NAVIGATION -->
    <div class="global-container pt-small pb-small">
      {{> "file-browser"}}
    </div>
    {{> "site-footer"}}

  </div>
  <script src="{{asset "js/pagination.js"}}" defer></script>
