{{!-- Banda de suscripción de la home. La tarjeta de adentro es la MISMA que va
      en la mitad de cada nota (partials/subscribe-card.hbs): un solo componente,
      un solo CSS. Lo propio de la home es la banda a todo el ancho con la tapa
      de la revista de fondo. --}}
{{#unless @member}}
{{> "subscribe-card-base"}}
<section class="wizband" aria-label="{{#if en}}Subscribe{{else}}Suscribite{{/if}}">
  <div class="global-container">
    {{#if en}}
      {{> "subscribe-card"
          eyebrow="Subscribe"
          title="No 421 article"
          titleAccent="is behind a paywall"
          text="And every contributor is paid for their work. Both things depend on our subscribers."
          btn="Subscribe →"
          priceNote="US$10 a month"
          href="/en/subscribe/"
          place="home-en" camp="sub-home-banner" ev="home_banner_subscribe"}}
    {{else}}
      {{> "subscribe-card"
          eyebrow="Suscribite"
          title="Las notas de 421"
          titleAccent="no tienen paywall"
          text="Y a cada colaborador se le paga por su trabajo. Las dos cosas dependen de los suscriptores."
          btn="Suscribite →"
          priceNote="US$10 por mes"
          href="/es/suscribite/"
          place="home-es" camp="sub-home-banner" ev="home_banner_subscribe"}}
    {{/if}}
  </div>
</section>

<style>
/* Banda a todo el ancho: tapa de la revista oscurecida + textura de las cards */
.wizband { position: relative; overflow: hidden; padding: 3rem 0; margin: 1.5rem 0; background: #141414; }
.wizband::before {
  content: ""; position: absolute; inset: 0;
  background-image: linear-gradient(rgba(15,15,15,0.74), rgba(15,15,15,0.86)), url(/content/images/size/w1600/2026/05/revista-10-trimmed.jpg);
  background-size: cover; background-position: center; background-repeat: no-repeat;
}
.wizband::after {
  content: ""; position: absolute; inset: 0;
  background-image: url({{asset "images/textura.webp"}});
  background-size: cover; background-position: center;
  mix-blend-mode: soft-light; opacity: 0.55; pointer-events: none;
}
.wizband > * { position: relative; z-index: 2; }
@media (max-width: 640px) { .wizband { padding: 2rem 0; } }
</style>
{{/unless}}
