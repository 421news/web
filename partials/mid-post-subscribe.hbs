{{!-- ===========================================================================
  CTA de suscripción embebido en la mitad de la nota.

  Es el cuarto punto de contacto del funnel y apunta a un lector distinto de los
  otros tres: el que ya bajó media nota (o sea, le está gustando) y le dio cerrar
  al popup. Por eso NO se dispara por scroll ni tapa nada — es un bloque más del
  artículo, en el corte natural entre dos párrafos.

  La tarjeta es LA MISMA de la home (partials/subscribe-card.hbs). Acá sólo se
  decide dónde va y en qué idioma. Si cambia el diseño o el copy, cambia en las
  dos superficies a la vez, que es el punto.

  Se incluye desde los tres wrappers de post (post-es / post-en / post-intl).

  Decisiones que no son cosméticas:

  1. El punto de inserción se calcula por LARGO DE TEXTO acumulado, no por
     cantidad de párrafos. Una nota que arranca con seis párrafos cortos y sigue
     con tres larguísimos tiene su mitad real muy lejos del párrafo del medio.

  2. Se inserta siempre después de un <p>, nunca entre un heading y su primer
     párrafo: cortar ahí parte una sección al medio y se lee como un error.

  3. No aparece en notas de menos de MIN_CHARS: en una nota corta el lector ve
     el CTA del header, este, y el del final en tres pantallas seguidas.

  4. El gate excluye `paid` Y `comped`: 221 de los ~232 que pagan lo hacen por
     MercadoPago y en Ghost figuran comped. Con el chequeo obvio, el 96% de los
     que pagan vería un CTA para suscribirse a algo que ya paga.
=========================================================================== --}}

{{#match @member.status "!=" "paid"}}{{#match @member.status "!=" "comped"}}
{{> "subscribe-card-base"}}
<template id="mps421-tpl">
  <div class="mps421-wrap">
    {{!-- El castellano va server-side por ser el idioma mayoritario; el resto lo
          reescribe el JS a partir de la URL, como el resto del theme. --}}
    {{> "subscribe-card"
        eyebrow="Suscribite"
        title="Las notas de 421"
        titleAccent="no tienen paywall"
        text="Y a cada colaborador se le paga por su trabajo. Las dos cosas dependen de los suscriptores."
        btn="Suscribite →"
        price="US$10 por mes"
        href="/es/suscribite/"
        place="post-es" camp="sub-mid-post" ev="midpost_subscribe"}}
  </div>
</template>

<style>
  .mps421-wrap { margin: 2.6rem 0; }
</style>

<script>
(function () {
  var MIN_CHARS = 2200;    // por debajo de esto la nota es demasiado corta (nota 3)
  var CORTE = 0.45;        // fracción del texto tras la cual se inserta

  // Mismo mensaje que la home, en los 7 idiomas restantes. El núcleo es el
  // porqué de 421: se le paga a todo el que colabora y ninguna nota queda
  // detrás de un muro. Verificado el 2026-09-09: 1.621 notas publicadas, las
  // 1.621 públicas. Si eso alguna vez deja de ser cierto, este copy miente.
  var I18N = {
    en: { eyebrow: 'Subscribe', title: 'No 421 article', accent: 'is behind a paywall',
          text: 'And every contributor is paid for their work. Both things depend on our subscribers.',
          btn: 'Subscribe →', price: 'US$10 a month', href: '/en/subscribe/' },
    pt: { eyebrow: 'Assine', title: 'Nenhuma matéria da 421', accent: 'tem paywall',
          text: 'E cada colaborador é pago pelo seu trabalho. As duas coisas dependem dos assinantes.',
          btn: 'Assine →', price: 'US$10 por mês', href: '/pt/subscribe/' },
    fr: { eyebrow: 'Abonnez-vous', title: 'Aucun article de 421', accent: 'n’a de paywall',
          text: 'Et chaque collaborateur est payé pour son travail. Les deux dépendent des abonnés.',
          btn: 'S’abonner →', price: 'US$10 par mois', href: '/fr/subscribe/' },
    zh: { eyebrow: '订阅', title: '421 的文章', accent: '没有付费墙',
          text: '每一位撰稿人都会因其工作获得报酬。这两件事都依靠订阅者。',
          btn: '订阅 →', price: '每月 10 美元', href: '/zh/subscribe/' },
    ja: { eyebrow: '購読', title: '421 の記事に', accent: 'ペイウォールはない',
          text: 'そして寄稿者には必ず報酬を支払っています。どちらも購読者に支えられています。',
          btn: '購読する →', price: '月額 10 ドル', href: '/ja/subscribe/' },
    ko: { eyebrow: '구독', title: '421의 기사에는', accent: '페이월이 없습니다',
          text: '그리고 모든 기고자에게 원고료를 지급합니다. 두 가지 모두 구독자에게 달려 있습니다.',
          btn: '구독하기 →', price: '월 10달러', href: '/ko/subscribe/' },
    tr: { eyebrow: 'Abone ol', title: '421’in yazılarında', accent: 'paywall yok',
          text: 'Ve her katkı sunana emeğinin karşılığı ödeniyor. İkisi de abonelere bağlı.',
          btn: 'Abone ol →', price: 'Aylık 10 US$', href: '/tr/subscribe/' }
  };


  function iniciar() {
    var tpl = document.getElementById('mps421-tpl');
    var cuerpo = document.querySelector('.rich-text.w-richtext');
    if (!tpl || !cuerpo) return;

    var bloques = Array.prototype.slice.call(cuerpo.children);
    var total = cuerpo.textContent.replace(/\s+/g, ' ').trim().length;
    if (total < MIN_CHARS || bloques.length < 6) return;   // nota 3

    // Punto de corte por texto acumulado (nota 1)
    var acum = 0, i = 0;
    for (; i < bloques.length; i++) {
      acum += bloques[i].textContent.length;
      if (acum >= total * CORTE) break;
    }
    // ...y siempre después de un párrafo, nunca partiendo un heading (nota 2)
    while (i < bloques.length - 1 && bloques[i].tagName !== 'P') i++;
    var ancla = bloques[i];
    if (!ancla || ancla === bloques[bloques.length - 1]) return;

    var nodo = tpl.content.firstElementChild.cloneNode(true);
    var card = nodo.querySelector('.home-wizard-cta');

    var m = window.location.pathname.match(/^\/([a-z]{2})\//);
    var lang = m ? m[1] : 'es';
    var t = I18N[lang];
    if (t) {
      nodo.querySelector('.hwc-eyebrow').textContent = '✦ ' + t.eyebrow;
      nodo.querySelector('.hwc-title').firstChild.nodeValue = t.title + ' ';
      nodo.querySelector('.hwc-grad').textContent = t.accent;
      nodo.querySelector('.hwc-text').textContent = t.text;
      nodo.querySelector('.hwc-price').textContent = t.price;
      var btn = nodo.querySelector('.hwc-btn');
      btn.textContent = t.btn;
      btn.href = t.href;
    }
    // Un idioma que no está en el diccionario cae a castellano, que es lo que
    // ya vino renderizado desde el server.
    card.setAttribute('data-hwc-place', 'post-' + (t ? lang : 'es'));

    ancla.parentNode.insertBefore(nodo, ancla.nextSibling);

    // La medición (click + impresión) la maneja subscribe-card-base.hbs; hay que
    // avisarle que apareció una tarjeta nueva, porque se insertó después.
    if (typeof window.hwcObservar === 'function') window.hwcObservar();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
  else iniciar();
})();
</script>
{{/match}}{{/match}}
