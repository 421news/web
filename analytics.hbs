</div>

<script>
var REVENUE_ENDPOINT = 'https://webhook-hreflang.onrender.com/api/revenue-data.json';

// Ghost mints a signed identity JWT for the logged-in member. Only a real
// logged-in member's browser can obtain one; the webhook verifies its signature.
var __memberToken = fetch('/members/api/session', { credentials: 'same-origin' })
  .then(function(r) { return r.status === 200 ? r.text() : null; })
  .catch(function() { return null; });

// Analytics = public aggregate feed (same data powers homepage most-read + media kit). No auth.
// De paso sirve de sonda: si este fetch al host de datos falla, el navegador no
// llega a Render (adblocker, VPN, red corporativa, o el servicio caido). Sin esa
// distincion, el gate de abajo muestra "acceso restringido" ante un problema de
// conectividad, que es un diagnostico falso y manda a pedir permisos que ya se tienen.
window.__hostDeDatosAlcanzable = null;
window.__ga4Data = (function() {
  var themeUrl = '{{asset "data/ga4-data.json"}}';
  var renderUrl = 'https://webhook-hreflang.onrender.com/api/ga4-data.json';
  var controller = new AbortController();
  var timer = setTimeout(function() { controller.abort(); }, 5000);
  return fetch(renderUrl, { signal: controller.signal })
    .then(function(r) { clearTimeout(timer); if (!r.ok) throw new Error(r.status); window.__hostDeDatosAlcanzable = true; return r.json(); })
    .catch(function() { clearTimeout(timer); window.__hostDeDatosAlcanzable = false; return fetch(themeUrl).then(function(r) { return r.json(); }); });
})();

// Revenue = SENSITIVE. Team-only via signed token. No public fallback. One fetch,
// reused for both the data promise and the page access gate.
var __revenueResp = __memberToken.then(function(token) {
  if (!token) return { status: 401 };
  return fetch(REVENUE_ENDPOINT, { headers: { 'Authorization': 'Bearer ' + token } })
    .then(function(r) {
      if (r.status === 200) return r.json().then(function(d) { return { status: 200, data: d }; });
      return { status: r.status };
    });
}).catch(function() { return { status: 0 }; });

window.__revenueData = __revenueResp.then(function(x) {
  return x.status === 200 ? x.data : Promise.reject(new Error('revenue-' + x.status));
});
window.__revenueData.catch(function() {}); // silence unhandled rejection; dashboard handles absence

// Page access gate: the revenue endpoint is the auth oracle.
// 200 (data ready) o 503 (es del equipo, los datos todavia cargan) => adentro.
//
// 401 y 403 son DOS PROBLEMAS DISTINTOS y hasta ahora mostraban el mismo cartel:
//   401 = el navegador no tiene sesion de miembro (nunca inicio sesion, o se le
//         vencio). Se arregla iniciando sesion.
//   403 = esta logueado pero su mail no tiene el label "equipo" en Ghost.
// Mostrarle "acceso restringido" a alguien que nunca inicio sesion lo manda a
// pedir un permiso que ya tiene. Paso exactamente eso con el equipo nuevo.
function mostrarEstado(id) {
  document.getElementById('auth-loading').style.display = 'none';
  document.getElementById(id).style.display = '';
}

// Con qué mail está logueado el navegador. Un 403 sin este dato es un callejón
// sin salida: el mail que tiene el label "equipo" en Ghost y el mail con el que
// quedó la sesión en ESE navegador pueden ser distintos, y desde afuera los dos
// casos se ven igual. Mostrarlo convierte el cartel en algo accionable.
function decirQuienSoy() {
  fetch('/members/api/member/', { credentials: 'same-origin' })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(m) {
      if (!m || !m.email) return;
      var el = document.getElementById('auth-denied-quien');
      el.textContent = 'Estás logueado como ' + m.email + '. Si esa no es tu cuenta de 421, cerrá sesión y entrá con la otra.';
      el.style.display = '';
    })
    .catch(function() {});
}

__revenueResp.then(function(x) {
  if (x.status === 200 || x.status === 503) return mostrarEstado('dashboard');
  if (x.status === 401) return mostrarEstado('auth-signin');
  // status 0 = el fetch ni salio (bloqueado o host inalcanzable). Se confirma con
  // la sonda al endpoint publico antes de acusar de nada al navegador.
  if (x.status === 0) {
    return window.__ga4Data.then(function() {
      mostrarEstado(window.__hostDeDatosAlcanzable === false ? 'auth-network' : 'auth-denied');
    }).catch(function() { mostrarEstado('auth-network'); });
  }
  mostrarEstado('auth-denied'); decirQuienSoy();
}).catch(function() {
  mostrarEstado('auth-denied'); decirQuienSoy();
});
// View toggle: Analytics | Revenue (lazy-init revenue dashboard on first show)
(function() {
  var tabs = document.querySelectorAll('.analytics-toptab');
  for (var i = 0; i < tabs.length; i++) {
    tabs[i].addEventListener('click', function() {
      var view = this.getAttribute('data-view');
      for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
      this.classList.add('active');
      document.getElementById('analytics-view').style.display = view === 'analytics' ? '' : 'none';
      document.getElementById('revenue-view').style.display = view === 'revenue' ? '' : 'none';
      if (view === 'revenue' && window.initRevenueDashboard) window.initRevenueDashboard();
    });
  }
})();
</script>
