{{!< default}}

    <link href="{{asset "css/suscribite.css"}}" rel="stylesheet" type="text/css">
    <div class="page-wrapper">
      {{> "general-styling"}}
      {{> "site-nav-intl"}}

      <div class="sub-page">
        <div class="sub-container">

          <div id="sub-section-plan">

            <div class="sub-hero">
              <span class="sub-hero-eyebrow" data-i18n="eyebrow">✦ Join 421</span>
              <h1 class="sub-hero-title" data-i18n="h1">Support 421</h1>
              <p class="sub-hero-subtitle" data-i18n-html="subtitle">421 articles have no paywall. And every contributor gets paid for their work. Both things matter a lot to us: that information flows without restrictions, and that every writer is paid fairly. For that to happen, <strong>we need you to subscribe</strong>.</p>
              <div class="sub-hero-proof" data-i18n="proof">235 subscribers · 5,694 registered</div>
            </div>
            <hr class="sub-gradient-divider">

            <div class="plan-toggle plan-toggle-global">
              <button class="plan-toggle-btn active" id="toggle-monthly" data-i18n="monthly">Monthly</button>
              <button class="plan-toggle-btn" id="toggle-yearly">
                <span data-i18n="annual">Annual</span>
                <span class="toggle-badge">-17%</span>
              </button>
            </div>

            <div class="tier-grid sub-first sub-three">

              <!-- SUBSCRIPTION -->
              <div class="tier featured" id="sub-plan-card">
                <span class="tier-badge" data-i18n="badge">Recommended</span>
                <h2 class="tier-name" data-i18n="subscribeName">Subscribe</h2>
                <p class="tier-tagline" data-i18n="subscribeTagline">Your subscription lets us pay the people who write and keeps every article available to everyone.</p>

                <div id="plan-price" class="tier-price">
                  <span class="tier-price-amount" id="price-amount">$9.99</span>
                  <span class="tier-price-period" id="price-period">USD / month</span>
                  <div class="plan-price-detail" id="price-detail"></div>
                </div>

                <p class="tier-includes" data-i18n="includes">What’s included?</p>
                <ul class="tier-benefits" data-i18n-list="subscribeBenefits">
                  <li class="tier-benefit-featured"><strong>Council</strong>: a monthly video call (in Spanish) with <a href="/author/juan-ruocco/">Juan Ruocco</a>, director of 421, to talk about what we’re reading, what’s happening in the world and how 421 is doing</li>
                  <li><strong>421 Magazine</strong> in PDF <strong>one month before</strong> public release</li>
                  <li><strong>Comment</strong> on every article</li>
                  <li>Access to the <a href="https://mtg.421.news">Magic: The Gathering 421 app</a></li>
                </ul>

                <button class="btn-gradient" id="btn-suscribirme" data-i18n="subscribeCta">Subscribe →</button>
                <div class="tier-foot">
                  <p class="tier-fine" data-i18n-html="payNote">Pay with an international card in USD through <strong>Stripe</strong>.</p>
                </div>
              </div>

              <!-- MECENAS: premium subscription test, Ghost tier "mecenas" -->
              <div class="tier tier-mecenas" id="sub-mecenas-card">
                <h2 class="tier-name" data-i18n="mecenasName">Patron</h2>
                <p class="tier-tagline" data-i18n="mecenasTagline">The biggest contribution to help 421 grow.</p>

                <div class="tier-price">
                  <span class="tier-price-amount" id="price-amount-mecenas">$100</span>
                  <span class="tier-price-period" id="price-period-mecenas">USD / month</span>
                </div>

                <p class="tier-includes" data-i18n="includes">What’s included?</p>
                <ul class="tier-benefits" data-i18n-list="mecenasBenefits">
                  <li><strong>Council</strong>: a monthly video call (in Spanish) with <a href="/author/juan-ruocco/">Juan Ruocco</a>, director of 421, to talk about what we’re reading, what’s happening in the world and how 421 is doing</li>
                  <li><strong>421 Magazine</strong> in PDF <strong>one month before</strong> public release</li>
                  <li><strong>Comment</strong> on every article</li>
                  <li>Access to the <a href="https://mtg.421.news">Magic: The Gathering 421 app</a></li>
                  <li class="tier-benefit-featured"><strong>Annual in-person meeting</strong> with <a href="/author/juan-ruocco/">Juan Ruocco</a> at the Ergodic offices in Buenos Aires</li>
                </ul>

                <button class="btn-outline btn-mecenas" id="btn-mecenas" data-i18n="mecenasCta">Become a patron →</button>
                <div class="tier-foot">
                  <p class="tier-fine" data-i18n-html="payNote">Pay with an international card in USD through <strong>Stripe</strong>.</p>
                </div>
              </div>

              <!-- REGISTER + LOGIN (secondary on purpose) -->
              <div class="tier tier-secondary">
                <h2 class="tier-name" data-i18n="registerName">Sign up</h2>
                <p class="tier-tagline" data-i18n="registerTagline">Create your account and download every magazine issue except the latest, which is for subscribers. Your session stays saved on any device.</p>

                <div class="tier-actions">
                  <button class="btn-outline" id="btn-free" data-i18n="registerCta">Sign up for free</button>
                  <div class="tier-foot">
                  <div class="tier-actions-divider" data-i18n="or">or</div>
                  <button class="btn-ghost" id="btn-login-toggle" data-i18n="loginToggle">I have an account · Log in</button>

                  <form class="inline-login" id="inline-login">
                    <input type="email" id="login-email" data-i18n-ph="loginPlaceholder" placeholder="you@email.com" required autocomplete="email">
                    <button type="submit" class="btn-outline" id="login-submit" data-i18n="loginSubmit">Send me the login link</button>
                    <div class="login-msg" id="login-msg"></div>
                    <button type="button" class="inline-login-back" id="btn-login-back" data-i18n="loginBack">&larr; Back</button>
                  </form>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

      {{> "site-footer"}}
    </div>

