            proof:'228 abone · 5.031 okuyucu',
            registerName:'Kayıt ol', registerTagline:'Ücretsiz hesabını oluştur ve 421 okumaya başla', freeLabel:'Ücretsiz',
            registerBenefits:['<strong>Yayınlanmış</strong> dergileri indirme (eski sayılar)','Oturumunu her cihazda koru'],
