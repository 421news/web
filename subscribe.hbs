{{!< default}}

{{!-- Metacard social y title: los emite ghost_head desde la página de Ghost
     que alimenta esta ruta (`data: page.subscribe` en routes.yaml).
     Acá había un bloque de JavaScript que pisaba document.title y las meta
     og:/twitter: en runtime. Era código muerto para lo único que importaba:
     ningún scraper de redes ejecuta JavaScript, así que WhatsApp, X, Telegram y
     Facebook veían siempre la metacard genérica del theme, en castellano y con
     la imagen por defecto. El copy se migró a los campos de la página. --}}

    <link href="{{asset "css/suscribite.css"}}" rel="stylesheet" type="text/css">
    <div class="page-wrapper">
      {{> "general-styling"}}
      {{> "site-nav-en"}}

      <div class="sub-page">
        <div class="sub-container">

          <!-- ===== SECTION 1: HERO + PLAN ===== -->
          <div id="sub-section-plan">

            <div class="sub-hero">
              <span class="sub-hero-eyebrow">✦ Join 421</span>
              <h1 class="sub-hero-title">Back 421</h1>
              <p class="sub-hero-subtitle">421 articles have no paywall. And every contributor gets paid for their work. Both things matter a lot to us: that information flows without restrictions, and that every writer is paid fairly. For that to happen, <strong>we need you to subscribe</strong>.</p>
              <div class="sub-hero-proof">235 subscribers · 5,694 registered</div>
            </div>
            <hr class="sub-gradient-divider">

            <div class="plan-toggle plan-toggle-global">
              <button class="plan-toggle-btn active" id="toggle-monthly">Monthly</button>
              <button class="plan-toggle-btn" id="toggle-yearly">
                Annual
                <span class="toggle-badge">-17%</span>
              </button>
            </div>

            <div class="tier-grid sub-first sub-three">

              <!-- SUBSCRIPTION -->
              <div class="tier featured" id="sub-plan-card">
                <span class="tier-badge">Recommended</span>
                <h2 class="tier-name">Subscribe</h2>
                <p class="tier-tagline">Your subscription lets us pay the people who write and keeps every article available to everyone.</p>

                <div id="plan-price" class="tier-price">
                  <span class="tier-price-amount" id="price-amount">$9.99</span>
                  <span class="tier-price-period" id="price-period">USD / month</span>
                  <div class="plan-price-detail" id="price-detail">Save 2 months with the annual plan</div>
                </div>

                <p class="tier-includes">What&rsquo;s included?</p>
                <ul class="tier-benefits">
                  <li class="tier-benefit-featured"><strong>Council</strong>: a monthly video call (in Spanish) with <a href="/author/juan-ruocco/">Juan Ruocco</a>, director of 421, to talk about what we&rsquo;re reading, what&rsquo;s happening in the world and how 421 is doing</li>
                  <li><strong>421 Magazine</strong> in PDF <strong>one month before</strong> public release</li>
                  <li><strong>Comment</strong> on every article</li>
                  <li>Access to the <a href="https://mtg.421.news">Magic: The Gathering 421 app</a></li>
                </ul>

                <button class="btn-gradient" id="btn-suscribirme">Subscribe &rarr;</button>
                <p class="tier-fine">Pay with an international card in USD through <strong>Stripe</strong>.</p>
              </div>

              <!-- MECENAS (patron): premium subscription test, Ghost tier "mecenas" -->
              <div class="tier tier-mecenas" id="sub-mecenas-card">
                <h2 class="tier-name">Patron</h2>
                <p class="tier-tagline">The biggest contribution to help 421 grow.</p>

                <div class="tier-price">
                  <span class="tier-price-amount" id="price-amount-mecenas">$100</span>
                  <span class="tier-price-period" id="price-period-mecenas">USD / month</span>
                </div>

                <p class="tier-includes">What&rsquo;s included?</p>
                <ul class="tier-benefits">
                  <li>Everything in the subscription</li>
                  <li class="tier-benefit-featured"><strong>Annual in-person meeting</strong> with <a href="/author/juan-ruocco/">Juan Ruocco</a> at the Ergodic offices in Buenos Aires</li>
                </ul>

                <button class="btn-outline btn-mecenas" id="btn-mecenas">Become a patron &rarr;</button>
              </div>

              <!-- REGISTER + LOGIN (secondary on purpose) -->
              <div class="tier tier-secondary">
                <h2 class="tier-name">Sign up</h2>
                <p class="tier-tagline">Create your account and download every magazine issue except the latest, which is for subscribers. Your session stays saved on any device.</p>

                <div class="tier-actions">
                  <button class="btn-outline" id="btn-free">Sign up for free</button>
                  <div class="tier-actions-divider">or</div>
                  <button class="btn-ghost" id="btn-login-toggle">I have an account · Log in</button>

                  <form class="inline-login" id="inline-login">
                    <input type="email" id="login-email" placeholder="you@email.com" required autocomplete="email">
                    <button type="submit" class="btn-outline" id="login-submit">Send me the login link</button>
                    <div class="login-msg" id="login-msg"></div>
                    <button type="button" class="inline-login-back" id="btn-login-back">&larr; Back</button>
                  </form>
                </div>
              </div>

            </div>
          </div>


          <!-- EN version: Stripe only, no MercadoPago -->

        </div>
      </div>

      {{> "site-footer" lang="en"}}
    </div>

    <script defer>
      document.addEventListener('DOMContentLoaded', function() {
        var currentCadence = 'monthly';
        var tierData = null;
        var tiersBy = { wizard: null, mecenas: null };

        fetch('https://421bn.ghost.io/ghost/api/content/tiers/?key=420da6f85b5cc903b347de9e33')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var tiers = data.tiers || [];
            // By slug: with two active paid tiers, "the first paid one" could be Mecenas.
            for (var i = 0; i < tiers.length; i++) {
              if (tiers[i].slug === 'supporter') tiersBy.wizard = tiers[i];
              if (tiers[i].slug === 'mecenas') tiersBy.mecenas = tiers[i];
            }
            tierData = tiersBy.wizard;
            updatePriceDisplay();
          })
          .catch(function() { /* price already shown as $9.99 fallback in HTML */ });

        function formatPrice(cents) {
          var dollars = cents / 100;
          return '$' + (dollars % 1 === 0 ? dollars : dollars.toFixed(2));
        }

        function updatePriceDisplay() {
          var mec = tiersBy.mecenas;
          if (mec) {
            document.getElementById('price-amount-mecenas').textContent = formatPrice(currentCadence === 'yearly' ? mec.yearly_price : mec.monthly_price);
            document.getElementById('price-period-mecenas').textContent = currentCadence === 'yearly' ? 'USD / year' : 'USD / month';
          }
          if (!tierData) return;
          var amountEl = document.getElementById('price-amount');
          var periodEl = document.getElementById('price-period');
          var detailEl = document.getElementById('price-detail');

          if (currentCadence === 'yearly') {
            amountEl.textContent = formatPrice(tierData.yearly_price);
            periodEl.textContent = 'USD / year';
            var monthlyTotal = tierData.monthly_price * 12;
            detailEl.innerHTML = '<span class="striked">' + formatPrice(monthlyTotal) + '</span> \u2014 save 2 months';
          } else {
            amountEl.textContent = formatPrice(tierData.monthly_price);
            periodEl.textContent = 'USD / month';
            detailEl.textContent = 'Save 2 months with the annual plan';
          }
        }

        var toggleM = document.getElementById('toggle-monthly');
        var toggleY = document.getElementById('toggle-yearly');

        toggleM.addEventListener('click', function() {
          currentCadence = 'monthly';
          toggleM.classList.add('active');
          toggleY.classList.remove('active');
          updatePriceDisplay();
        });

        toggleY.addEventListener('click', function() {
          currentCadence = 'yearly';
          toggleY.classList.add('active');
          toggleM.classList.remove('active');
          updatePriceDisplay();
        });

        function checkout(tier) {
          var t = tiersBy[tier];
          if (!t) return;
          if (typeof gtag === 'function') {
            gtag('event', 'begin_checkout', {
              event_category: 'subscription',
              event_label: tier + '_' + currentCadence + '_en',
              value: currentCadence === 'yearly' ? (t.yearly_price/100) : (t.monthly_price/100),
              currency: 'USD',
              items: [{ item_id: t.id, item_name: (tier === 'mecenas' ? 'Mecenas ' : 'Wizard ') + currentCadence }]
            });
            if (tier === 'mecenas') gtag('event', 'mecenas_click', { event_category: 'subscription', event_label: 'mecenas_' + currentCadence + '_en' });
          }
          window.location.hash = '#/portal/signup/' + t.id + '/' + currentCadence;
        }
        document.getElementById('btn-suscribirme').addEventListener('click', function() { checkout('wizard'); });
        document.getElementById('btn-mecenas').addEventListener('click', function() { checkout('mecenas'); });

        document.getElementById('btn-free').addEventListener('click', function() {
          if (typeof gtag === 'function') gtag('event', 'sign_up_intent', {
            event_category: 'subscription',
            event_label: 'free_register_en'
          });
          window.location.hash = '#/portal/signup/free';
        });

        // ===== Inline login (magic link, signin) =====
        var loginForm = document.getElementById('inline-login');
        var loginEmail = document.getElementById('login-email');
        var loginSubmit = document.getElementById('login-submit');

        function setLoginMsg(text, cls) {
          var m = document.getElementById('login-msg');
          m.textContent = text;
          m.className = 'login-msg' + (cls ? ' ' + cls : '');
        }

        document.getElementById('btn-login-toggle').addEventListener('click', function() {
          loginForm.classList.add('open');
          setLoginMsg('', '');
          loginEmail.focus();
        });
        document.getElementById('btn-login-back').addEventListener('click', function() {
          loginForm.classList.remove('open');
          setLoginMsg('', '');
        });

        function getIntegrityToken() {
          return fetch('/members/api/integrity-token/', { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.text() : ''; })
            .catch(function() { return ''; });
        }

        loginForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var email = loginEmail.value.trim();
          if (!email) return;
          loginSubmit.disabled = true;
          setLoginMsg('Sending…', '');
          if (typeof gtag === 'function') gtag('event', 'login_magiclink_request', { event_category: 'subscription', event_label: 'subscribe_en' });
          getIntegrityToken().then(function(token) {
            var body = { email: email, emailType: 'signin' };
            if (token) body.integrityToken = token;
            return fetch('/members/api/send-magic-link/', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            });
          })
          .then(function(r) {
            if (!r.ok) throw new Error('http ' + r.status);
            setLoginMsg('✓ We sent a login link to ' + email + '.', 'ok');
          })
          .catch(function() {
            setLoginMsg('Couldn’t send the link. Check the email and try again.', 'err');
            loginSubmit.disabled = false;
          });
        });
      });
    </script>
