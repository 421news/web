{{!< default}}

{{!-- Book reviews — landing de la seccion, version en ingles de resenas.hbs.
     Ruta: /en/reviews/ (routes.yaml, data: page.reviews)
     La membresia es el tag publico `review`. --}}

{{> "breadcrumb-tag" tagName="Book reviews" lang="en"}}

  <div class="page-wrapper">
    {{> "general-styling"}}
    {{> "site-nav-en"}}
    <main>
      <!-- SECTION HEADER -->
      {{> "tag-hero-section" tagSlug="review" languageFilter="'hash-en'" eyebrow="Section" postsLabel="reviews" postsLabelSingular="review" titulo="Book reviews" sinDestacados=true}}

      <!-- LIST -->
      {{> "last-posts-en-tag" tag="review"}}

    </main>

    <!-- FILE BROWSER NAVIGATION -->
    <div class="global-container pt-small pb-small">
      {{> "file-browser-en"}}
    </div>
    {{> "site-footer" lang="en"}}

  </div>
  <script src="{{asset "js/pagination.js"}}" defer></script>
