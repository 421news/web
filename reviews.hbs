{{!< default}}

{{!-- Book reviews — landing de la seccion, version en ingles de resenas.hbs.
     Ruta: /en/reviews/ (routes.yaml, data: page.reviews)
     La membresia es el tag publico `review` (en castellano es `resena`).

     No lleva CSS propio a proposito: se arma con section-hero + post-card +
     global-container, que ya tienen sus reglas en light-mode.css. --}}

{{> "breadcrumb-tag" tagName="Reviews" lang="en"}}

<div class="page-wrapper">
  {{> "general-styling"}}
  {{> "site-nav-en"}}

  <main>
    {{> "section-hero"
        eyebrow="421 · section"
        title="Book reviews"
        tesis="Books read closely and argued with: what each one proposes, what it takes issue with, and who it might be for."}}

    <div class="preview-section">
      <div class="global-container">
        <div class="pv-huge">
          <div class="last-posts-section">
            {{#get "posts"
                include="tags,authors"
                filter="tag:review+tag:hash-en"
                limit="all"
                order="published_at desc"
                as |articles|
            }}
              {{#if articles}}
                {{#foreach articles}}
                  {{> "post-card"}}
                {{/foreach}}
              {{else}}
                <p class="section-meta-label">No reviews published yet.</p>
              {{/if}}
            {{/get}}
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- FILE BROWSER NAVIGATION -->
  <div class="global-container pt-small pb-small">
    {{> "file-browser-en"}}
  </div>

  {{> "site-footer" lang="en"}}
</div>
